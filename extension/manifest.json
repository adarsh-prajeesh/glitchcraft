{
  "manifest_version": 3,
  "name": "Cross ID - Multi-Factor Auto-Sign-In",
  "version": "1.0.0",
  "description": "Seamless Single Sign-On (SSO) assistant powered by Cross ID Biometric & Cryptographic Proofs. Automatically signs into portals and partner sites.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cross ID SSO Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file:///*"],
      "js": ["portal-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>", "file:///*"],
      "js": ["partner-content.js"],
      "css": ["partner-content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
